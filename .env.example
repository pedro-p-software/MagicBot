# Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Local LM Studio Settings (Default port is 1234)
LM_STUDIO_URL=http://localhost:1234/v1

# Optional fallback used only if Telegram is unavailable while the bot starts.
# Do not include @. Example: magicalliancebot
BOT_USERNAME=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
